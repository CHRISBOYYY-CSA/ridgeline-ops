<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Become an Operator — Ridgeline Ops</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header') %>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Register as an Operator</h2>
        <p>List your skills so farmers looking to hire can find you.</p>
      </div>

      <% if (confirmed) { %>
        <div class="confirm-banner">You're registered. Farmers can now find and hire you under "Hire an Operator".</div>
      <% } %>

      <form class="form-card" method="POST" action="/register-operator">
        <div class="field">
          <label for="name">Full Name</label>
          <input type="text" id="name" name="name" required>
        </div>
        <div class="field">
          <label for="location">Location</label>
          <input type="text" id="location" name="location" required>
        </div>
        <div class="field">
          <label for="machine">Machine Specialty</label>
          <select id="machine" name="machine" required>
            <% machines.forEach(m => { %>
              <option value="<%= m.name %>"><%= m.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label for="experience">Years of Experience</label>
          <input type="number" id="experience" name="experience" min="0" required>
        </div>
        <div class="field">
          <label for="rate">Your Rate per Day (₦)</label>
          <input type="number" id="rate" name="rate" min="0" required>
        </div>
        <button type="submit" class="btn btn-primary">Register</button>
      </form>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
